{
  "name": "@snow-the/dsh-busyloop",
  "version": "0.1.4",
  "description": "DSH agent-loop engine: host-LLM adapter (official ctx.llm channel) + lightweight loop skeleton over host ctx. Capability layer — codex style is opt-in via dsh-busyloop-codexstyle.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@deepseek-ai/*",
    "test": "node --test --test-concurrency=1"
  },
  "keywords": [
    "dsh",
    "plugin",
    "agent",
    "loop",
    "llm"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@types/node": "^22.20.1",
    "esbuild": "^0.24.2",
    "hono": "^4.13.3",
    "typescript": "^5.9.3"
  }
}
